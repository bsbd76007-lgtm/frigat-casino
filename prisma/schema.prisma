generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  BET
  WIN
  AFFILIATE_REWARD
  AFFILIATE_CLAIM
  BONUS_CASHBACK
  DEPOSIT_BONUS
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELED
}

enum CryptoPaymentStatus {
  PENDING
  PENDING_ADMIN_REVIEW
  CONFIRMING
  CONFIRMED
  PAID
  PAID_OVER
  WRONG_AMOUNT
  CANCELLED
  EXPIRED
  FAILED
}

enum RaffleStatus {
  ACTIVE
  COMPLETED
}

enum GameType {
  CRASH
  MINES
  ROULETTE
  COINFLIP
  PLINKO
  DICE
  LIMBO
  KENO
  CHICKEN
  SLOTS
  AVIA
}

model User {
  id           String   @id @default(cuid())
  telegramId   String?  @unique
  email        String   @unique
  passwordHash String?
  googleId     String?  @unique
  tokenVersion Int      @default(0)
  role         Role     @default(USER)
  createdAt    DateTime @default(now())

  frozen       Boolean   @default(false)
  frozenAt     DateTime?
  frozenReason String?

  totpSecret      String?
  totpEnabled     Boolean   @default(false)
  totpLastStep    Int?
  totpBackupCodes String[]  @default([])

  telegramUsername String?
  telegramLinkedAt DateTime?

  deletedAt DateTime?

  referralCode       String  @unique @default(cuid())
  referredById       String?
  revSharePercentage Decimal @default(10.00) @db.Decimal(5, 2)

  referredBy User?  @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals  User[] @relation("Referrals")

  lastDailyWheelSpinAt DateTime?

  lastCheckInAt DateTime?
  checkInStreak Int       @default(0)

  promoRedemptions PromoRedemption[]
  raffleTickets    RaffleTicket[]
  raffleEntries    RaffleEntry[]

  currentStreak     Int       @default(0)
  longestStreak     Int       @default(0)
  lastPlayedDate    DateTime?
  streakRestoreCost Decimal   @default(0) @db.Decimal(18, 8)
  restorableStreak  Int       @default(0)
  streakBrokenAt    DateTime?

  wallets        Wallet[]
  payments       Payment[]
  withdrawals    Withdrawal[]
  rakebackClaims RakebackClaim[]
  gameSessions   GameSession[]
  provableSeeds  ProvableSeed[]
  auditActions   AdminAuditLog[] @relation("AdminActions")
  auditTargets   AdminAuditLog[] @relation("AuditTargets")
  supportTickets SupportTicket[]

  @@index([telegramId])
  @@index([referredById])
}

model Wallet {
  id               String   @id @default(cuid())
  userId           String
  balance          Decimal  @default(0) @db.Decimal(18, 8)
  affiliateBalance Decimal  @default(0.00) @db.Decimal(18, 8)
  currency         String   @default("USD")
  updatedAt        DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([userId, currency])
  @@index([userId])
}

model Transaction {
  id         String            @id @default(cuid())
  walletId   String
  type       TransactionType
  amount     Decimal           @db.Decimal(18, 8)
  status     TransactionStatus @default(PENDING)
  txHash     String?           @unique
  providerId String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @default(now()) @updatedAt

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Restrict)

  @@index([walletId, createdAt])
  @@index([status])
  @@index([providerId])
}

model Payment {
  id       String              @id @default(cuid())
  userId   String
  amount   Decimal             @db.Decimal(18, 8)
  currency String
  status   CryptoPaymentStatus @default(PENDING)

  provider String @default("CRYPTOMUS")

  paymentId String  @unique
  txHash    String?

  address String?
  payUrl  String?

  paidAmount Decimal? @db.Decimal(18, 8)

  transactionId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status])
}

model Withdrawal {
  id       String              @id @default(cuid())
  userId   String
  amount   Decimal             @db.Decimal(18, 8)
  payoutAmount Decimal?        @db.Decimal(18, 8)
  exchangeRateUsdt Decimal?    @db.Decimal(24, 12)
  exchangeRateSource String?
  currency String
  status   CryptoPaymentStatus @default(PENDING)

  provider String @default("CRYPTOMUS")

  paymentId String? @unique
  txHash    String?

  address String
  network String?

  transactionId String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status])
}

model RakebackClaim {
  id        String   @id @default(cuid())
  userId    String
  amount    Decimal  @db.Decimal(18, 8)
  currency  String   @default("USD")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model GameSession {
  id         String   @id @default(cuid())
  userId     String
  gameType   GameType
  betAmount  Decimal  @db.Decimal(18, 8)
  payout     Decimal  @default(0) @db.Decimal(18, 8)
  multiplier Float    @default(0)
  serverSeed String
  clientSeed String
  nonce      Int
  resultData Json
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([gameType, createdAt])
}

model ProvableSeed {
  id               String  @id @default(cuid())
  userId           String
  serverSeed       String
  hashedServerSeed String
  clientSeed       String
  nonce            Int     @default(0)
  active           Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, active])
}

model AdminAuditLog {
  id           String   @id @default(cuid())
  adminId      String
  action       String
  targetUserId String?
  details      Json
  createdAt    DateTime @default(now())

  admin  User  @relation("AdminActions", fields: [adminId], references: [id], onDelete: Restrict)
  target User? @relation("AuditTargets", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([adminId, createdAt])
  @@index([targetUserId])
}

model PlatformConfig {
  id                 String   @id @default("singleton")
  maintenanceMode    Boolean  @default(false)
  maintenanceMessage String?
  updatedAt          DateTime @updatedAt
  updatedBy          String?
}

model GameLimit {
  gameType  GameType @id
  minBet    Decimal  @db.Decimal(18, 8)
  maxBet    Decimal  @db.Decimal(18, 8)
  maxWin    Decimal  @default(0) @db.Decimal(18, 8)
  updatedAt DateTime @updatedAt
  updatedBy String?
}

enum SupportStatus {
  OPEN
  CLOSED
}

enum SupportSender {
  USER
  ADMIN
}

model SupportTicket {
  id        String        @id @default(cuid())
  userId    String?
  user      User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  userEmail String
  status    SupportStatus @default(OPEN)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  messages SupportMessage[]

  @@index([status, updatedAt])
  @@index([userId, status])
}

model SupportMessage {
  id        String        @id @default(cuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender    SupportSender
  text      String
  createdAt DateTime      @default(now())

  @@index([ticketId, createdAt])
}

model OtpCode {
  id        String   @id @default(cuid())
  email     String
  codeHash  String
  expiresAt DateTime
  used      Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  purpose      String  @default("LOGIN")
  passwordHash String?

  @@index([email, createdAt])
  @@index([expiresAt])
}

model PromoCode {
  id     String @id @default(cuid())
  code   String @unique
  amount Decimal @db.Decimal(18, 8)
  currency String @default("USD")
  maxRedemptions Int?
  redemptionCount Int @default(0)
  expiresAt DateTime?
  active   Boolean  @default(true)
  note      String?
  createdAt DateTime @default(now())

  redemptions PromoRedemption[]

  @@index([active, expiresAt])
}

model PromoRedemption {
  id          String   @id @default(cuid())
  promoCodeId String
  userId      String
  amount      Decimal  @db.Decimal(18, 8)
  createdAt   DateTime @default(now())

  promoCode PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([promoCodeId, userId])
  @@index([userId, createdAt])
}

model Raffle {
  id          String       @id @default(cuid())
  title       String
  prizePool   String
  prizeValue  Decimal?     @db.Decimal(18, 8)
  ticketPrice Decimal?     @db.Decimal(18, 8)
  endsAt      DateTime
  status      RaffleStatus @default(ACTIVE)
  ticketCounter Int @default(0)

  winningTicketNumber Int?
  winnerUserId        String?
  drawnAt             DateTime?

  createdAt DateTime @default(now())

  tickets RaffleTicket[]
  entries RaffleEntry[]

  @@index([status, endsAt])
}

model RaffleTicket {
  id           String   @id @default(cuid())
  raffleId     String
  userId       String
  ticketNumber Int
  source       String
  createdAt    DateTime @default(now())

  raffle Raffle @relation(fields: [raffleId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([raffleId, ticketNumber])
  @@index([raffleId, createdAt])
  @@index([raffleId, userId])
}

model RaffleEntry {
  id       String @id @default(cuid())
  raffleId String
  userId   String
  wageredCredited Decimal @default(0) @db.Decimal(18, 8)
  lastCheckInTicketAt DateTime?
  depositsCredited Int @default(0)

  raffle Raffle @relation(fields: [raffleId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([raffleId, userId])
}
