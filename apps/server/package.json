{
  "name": "@frigat/server",
  "version": "0.1.0",
  "private": true,
  "main": "src/index.ts",
  "scripts": {
    "shared": "tsc -p ../../packages/shared/tsconfig.json",
    "predev": "npm run shared",
    "dev": "tsx watch src/index.ts",
    "prebuild": "npm run shared",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "pretest": "npm run shared",
    "test": "vitest run",
    "seed": "prisma db seed",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "prisma": {
    "seed": "tsx ../../prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/websocket": "^11.3.3",
    "@frigat/shared": "*",
    "@prisma/client": "^5.16.0",
    "argon2": "^0.40.3",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.5",
    "google-auth-library": "^11.1.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.0.16",
    "pino-pretty": "^13.1.3",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.0",
    "@types/nodemailer": "^8.0.1",
    "@types/ws": "^8.5.10",
    "@vitest/coverage-v8": "^4.1.10",
    "tsx": "^4.16.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
